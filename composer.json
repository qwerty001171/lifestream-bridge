{
    "name": "isp/lifestream-bridge",
    "description": "Middleware billing service between billing and Lifestream IPTV platform",
    "keywords": ["laravel", "billing", "lifestream", "iptv", "roadrunner"],
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "darkaonline/l5-swagger": "^9.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.7",
        "php-http/client-common": "*",
        "php-http/discovery": "*",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "symfony/options-resolver": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/validator": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.21",
        "jane-php/open-api-3": "*",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
"post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "audit": {
        "ignore": ["PKSA-xbp4-qwr2-cbjj"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
