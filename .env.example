APP_NAME=lifestream-bridge
APP_ENV=local
APP_KEY=
APP_BASE_PATH=/app
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=billing_service
DB_USERNAME=billing
DB_PASSWORD=secret

# -----------------------------------------------------------------------
# Cache & Queue (Redis)
# -----------------------------------------------------------------------
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------
# Lifestream TV Platform API
# -----------------------------------------------------------------------
LIFESTREAM_URL=
LIFESTREAM_TIMEOUT=30
LIFESTREAM_RETRIES=3
LIFESTREAM_RETRY_DELAY=500
LIFESTREAM_RATE_LIMIT=10

# -----------------------------------------------------------------------
# Биллинг — регионы / источники
# -----------------------------------------------------------------------
BILLING_ADAPTER=\App\Adapters\HttpBillingAdapter
BILLING_PAGE_LIMIT=1000

# Регион A
BILLING_REGION_A_URL=
BILLING_REGION_A_KEY=

# Регион B
BILLING_REGION_B_URL=
BILLING_REGION_B_KEY=
