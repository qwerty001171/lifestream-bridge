APP_NAME=lifestream-bridge
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
MIGRATE_ON_STARTUP=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=billing_service
DB_USERNAME=billing
DB_PASSWORD=secret

# Cache & Queue (Redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lifestream TV Platform API
LIFESTREAM_URL=
LIFESTREAM_TIMEOUT=30
LIFESTREAM_RETRIES=3
LIFESTREAM_RETRY_DELAY=500
LIFESTREAM_RATE_LIMIT=10

# Источник
BILLING_ADAPTER=\App\Adapters\HttpBillingAdapter
BILLING_PAGE_LIMIT=1000
BILLING_MAX_PAGES=5000
BILLING_SYNC_LOCK_TTL=300

# Источник A
BILLING_SOURCE_A_URL=
BILLING_SOURCE_A_KEY=

# Источник B
BILLING_SOURCE_B_URL=
BILLING_SOURCE_B_KEY=
